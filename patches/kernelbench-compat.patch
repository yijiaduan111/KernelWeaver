new file mode 100644
--- /dev/null
+++ b/src/kernelbench/safe_compare.py
@@ -0,0 +1,43 @@
+"""Opt-in bounded-memory verification; no sampling or relaxed tolerances."""
+import os
+
+import torch
+
+
+def tensor_chunks(a, b, limit):
+    """Yield views, including strided tensors, without copying a whole output."""
+    if a.numel() <= limit:
+        yield a, b
+    elif a.is_contiguous() and b.is_contiguous():
+        a, b = a.view(-1), b.view(-1)
+        for start in range(0, a.numel(), limit):
+            yield a[start:start + limit], b[start:start + limit]
+    else:
+        axis = max(range(a.ndim), key=lambda i: a.shape[i])
+        step = max(1, limit // (a.numel() // a.shape[axis]))
+        for start in range(0, a.shape[axis], step):
+            size = min(step, a.shape[axis] - start)
+            yield from tensor_chunks(a.narrow(axis, start, size), b.narrow(axis, start, size), limit)
+
+
+def allclose(a, b, *, rtol=1e-5, atol=1e-8, equal_nan=False, chunk_elements=None):
+    limit = int(os.environ.get("KERNELBENCH_CHECK_CHUNK_ELEMENTS", "0")) if chunk_elements is None else chunk_elements
+    if limit <= 0 or a.shape != b.shape or a.numel() <= limit:
+        return torch.allclose(a, b, rtol=rtol, atol=atol, equal_nan=equal_nan)
+    # Every element must pass exactly the original torch.allclose test.
+    return all(torch.allclose(x, y, rtol=rtol, atol=atol, equal_nan=equal_nan)
+               for x, y in tensor_chunks(a, b, limit))
+
+
+def difference_stats(a, b):
+    limit = int(os.environ.get("KERNELBENCH_CHECK_CHUNK_ELEMENTS", "0"))
+    if limit <= 0 or a.numel() <= limit:
+        return torch.max(torch.abs(a - b)).item(), torch.mean(torch.abs(a - b)).item()
+    maximum = torch.zeros((), device=a.device, dtype=a.real.dtype)
+    total = torch.zeros((), device=a.device, dtype=torch.float64)
+    for x, y in tensor_chunks(a, b, limit):
+        diff = torch.abs(x - y)
+        maximum = torch.maximum(maximum, diff.max())
+        total += diff.sum(dtype=torch.float64)
+    # Diagnostics only: double-precision summation does not affect pass/fail.
+    return maximum.item(), (total / a.numel()).item()
