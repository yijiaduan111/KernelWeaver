# Copy to .env and use credentials belonging to your own account.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-id
OPENAI_WIRE_API=chat_completions

# Optional native Claude-compatible endpoint.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=your-claude-model-id
CLAUDE_API_VERSION=2023-06-01

# Optional MicuAPI route. Override the model for your account.
MICU_API_KEY=
MICU_BASE_URL=https://www.micuapi.ai/v1
MICU_MODEL=your-model-id

# Optional local cudaLLM route. No model weights are included.
CUDALLM_MODEL_PATH=models/cudaLLM-8B
CUDALLM_DEVICE=cuda:0
